# Backend environment. Copy to .env and fill in.
#   cp .env.example .env
#
# The frontend has its own file — frontend/.env — because Vite only reads env
# from its own project root. Nothing prefixed VITE_ belongs here.

# --- Server ---------------------------------------------------------------
PORT=7000
# Origin allowed by CORS, and the base of the link in verification emails.
CLIENT_URL=http://localhost:5173

# --- MongoDB --------------------------------------------------------------
# Read at call time inside config/database.js, so load order doesn't matter.
DB_CONNECT_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# --- Redis ----------------------------------------------------------------
# NOTE: config/redis.js builds its client at module scope, so these are read
# the moment that file is first required. src/index.js loads dotenv before any
# require for exactly this reason — don't reorder those lines.
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# --- Auth -----------------------------------------------------------------
# Any long random string. Tests use a hardcoded fake, never this value.
JWT_SECRET_KEY=

# --- Judge0 (self-hosted) -------------------------------------------------
JUDGE0_BASE_URL=http://<host>:2358
JUDGE0_AUTH_TOKEN=

# --- Mail (Gmail SMTP) ----------------------------------------------------
# EMAIL_PASS is a Google App Password, not the account password.
EMAIL_USER=
EMAIL_PASS=
