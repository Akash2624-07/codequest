# Frontend environment. Copy to .env and fill in.
#   cp .env.example .env
#
# This file has to live here, not in the repo root: Vite reads env from its own
# project root, and only exposes variables prefixed VITE_. Anything here is
# baked into the client bundle at build time, so never put a secret in it.

# Backend base URL — must match PORT in the root .env.
VITE_API_URL=http://localhost:7000
