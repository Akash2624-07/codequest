{
  "name": "codequest",
  "version": "1.0.0",
  "description": "Backend API for CodeQuest, an online judge where users solve programming problems and run or submit solutions in five languages against hidden test cases via Judge0. Express 5 + MongoDB + Redis, with JWT auth, email verification, and admin problem management.",
  "main": "src/index.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akash2624-07/codequest.git"
  },
  "keywords": [
    "online-judge",
    "competitive-programming",
    "code-execution",
    "judge0",
    "express",
    "mongodb",
    "redis",
    "jwt-auth"
  ],
  "author": "Akash Harshvardhan (https://github.com/Akash2624-07)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Akash2624-07/codequest/issues"
  },
  "homepage": "https://github.com/Akash2624-07/codequest#readme",
  "dependencies": {
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.1",
    "nodemailer": "^9.0.3",
    "nodemon": "^3.1.14",
    "redis": "^5.12.1",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "bcrypt": false,
    "mongodb-memory-server": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
